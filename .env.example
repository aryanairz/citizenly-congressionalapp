# Copy this file to `.env` and set the base URL of the Citizenly backend.
#
# Any variable prefixed with EXPO_PUBLIC_ is inlined into the app bundle by Expo.
#
# Testing on a physical phone via Expo Go:
#   - "localhost" / 127.0.0.1 will NOT work — that points at the phone itself.
#   - Use your computer's LAN IP so the phone can reach your dev server, e.g.:
#       EXPO_PUBLIC_API_BASE=http://192.168.1.42:3000
#   - Find your IP: `ipconfig` on Windows (look for IPv4 Address).
#   - Your website must be running (`npm run dev`) and on the same Wi-Fi.
#
# iOS Simulator / Android emulator on the same machine can use localhost
# (Android emulator: http://10.0.2.2:3000).
EXPO_PUBLIC_API_BASE=http://192.168.1.42:3000
